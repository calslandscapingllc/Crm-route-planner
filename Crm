<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Cal's Route Planner & CRM</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    body { -webkit-tap-highlight-color: transparent; }
    .tab-active { border-b-2 border-emerald-600 text-emerald-700 font-bold; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen pb-20">

  <!-- Header -->
  <header class="bg-emerald-800 text-white px-4 py-3 sticky top-0 z-30 shadow-md flex justify-between items-center">
    <div>
      <h1 class="text-lg font-bold tracking-tight">Cal's Route & Field CRM</h1>
      <p class="text-xs text-emerald-200">Start: 3587 S 8150 W, Magna</p>
    </div>
    <div class="flex gap-2">
      <button onclick="openClientModal()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-2.5 py-1.5 rounded text-xs font-semibold flex items-center gap-1 shadow">
        <i data-lucide="user-plus" class="w-4 h-4"></i> Add Client
      </button>
    </div>
  </header>

  <!-- Top Navigation Tabs -->
  <nav class="bg-white border-b border-slate-200 sticky top-[57px] z-20 flex text-center text-sm font-medium text-slate-600">
    <button id="tab-btn-route" onclick="switchTab('route')" class="flex-1 py-3 tab-active flex justify-center items-center gap-1">
      <i data-lucide="map" class="w-4 h-4"></i> Today's Route
    </button>
    <button id="tab-btn-clients" onclick="switchTab('clients')" class="flex-1 py-3 flex justify-center items-center gap-1">
      <i data-lucide="users" class="w-4 h-4"></i> Client Database
    </button>
  </nav>

  <!-- Main Container -->
  <main class="max-w-2xl mx-auto p-4 space-y-4">

    <!-- TAB 1: TODAY'S ROUTE -->
    <div id="tab-route" class="space-y-4">
      
      <!-- Route Controls Card -->
      <div class="bg-white p-3 rounded-lg shadow-sm border border-slate-200 flex flex-wrap gap-2 justify-between items-center text-xs">
        <div class="flex items-center gap-2">
          <label class="font-bold text-slate-700">Start Time:</label>
          <input type="time" id="route-start-time" value="08:00" onchange="renderRoute()" class="border border-slate-300 rounded px-1.5 py-1 text-xs" />
        </div>
        <div class="flex gap-2">
          <button onclick="resetStopsStatus()" class="text-slate-500 hover:text-slate-800 underline">Reset Status</button>
          <button onclick="openAddStopModal()" class="bg-slate-800 text-white px-2 py-1 rounded hover:bg-slate-700 flex items-center gap-1 font-medium">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add Stop
          </button>
        </div>
      </div>

      <!-- Route List -->
      <div id="route-list" class="space-y-3">
        <!-- Rendered via JS -->
      </div>
    </div>

    <!-- TAB 2: CLIENT DATABASE -->
    <div id="tab-clients" class="hidden space-y-4">
      
      <!-- Client Actions Bar -->
      <div class="bg-white p-3 rounded-lg shadow-sm border border-slate-200 flex gap-2">
        <div class="relative flex-1">
          <i data-lucide="search" class="w-4 h-4 absolute left-2.5 top-2.5 text-slate-400"></i>
          <input type="text" id="client-search" placeholder="Search client name, phone, or address..." oninput="renderClients()" class="w-full pl-8 pr-3 py-1.5 border border-slate-300 rounded text-xs focus:outline-emerald-600" />
        </div>
        <button onclick="importContactsNative()" title="Import from Phone" class="bg-slate-100 hover:bg-slate-200 border border-slate-300 px-2 py-1.5 rounded text-xs flex items-center gap-1 text-slate-700 font-medium">
          <i data-lucide="contact" class="w-4 h-4"></i> Sync Contacts
        </button>
      </div>

      <!-- Clients List -->
      <div id="clients-list" class="space-y-3">
        <!-- Rendered via JS -->
      </div>
    </div>
  </main>

  <!-- MODAL: ADD/EDIT CLIENT -->
  <div id="modal-client" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-3 overflow-y-auto">
    <div class="bg-white rounded-lg max-w-lg w-full max-h-[90vh] overflow-y-auto p-5 space-y-4 shadow-xl">
      <div class="flex justify-between items-center border-b pb-2">
        <h2 id="modal-client-title" class="text-base font-bold text-slate-800">Add New Client</h2>
        <button onclick="closeClientModal()" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>

      <form id="client-form" onsubmit="saveClient(event)" class="space-y-3 text-xs">
        <input type="hidden" id="client-id" />

        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block font-semibold mb-1">Full Name *</label>
            <input type="text" id="client-name" required class="w-full border p-2 rounded" />
          </div>
          <div>
            <label class="block font-semibold mb-1">Phone Number *</label>
            <input type="tel" id="client-phone" required class="w-full border p-2 rounded" />
          </div>
        </div>

        <div>
          <label class="block font-semibold mb-1">Service Address *</label>
          <input type="text" id="client-address" required placeholder="Street, City, UT" class="w-full border p-2 rounded" />
        </div>

        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block font-semibold mb-1">Property Type</label>
            <select id="client-type" class="w-full border p-2 rounded bg-white">
              <option value="Residential">Residential</option>
              <option value="Commercial">Commercial</option>
            </select>
          </div>
          <div>
            <label class="block font-semibold mb-1">Sprinkler Controller</label>
            <select id="client-controller" class="w-full border p-2 rounded bg-white">
              <option value="Rain Bird">Rain Bird</option>
              <option value="Hunter">Hunter</option>
              <option value="Toro">Toro</option>
              <option value="Irritrol">Irritrol</option>
              <option value="Orbit / B-hyve">Orbit / B-hyve</option>
              <option value="Other">Other / None</option>
            </select>
          </div>
        </div>

        <!-- Sizing & Pricing Calculator -->
        <div class="border rounded p-3 bg-slate-50 space-y-2">
          <p class="font-bold text-slate-700">Property Measurements (Sq Ft / Lin Ft)</p>
          <div class="grid grid-cols-3 gap-2">
            <div>
              <label class="block text-[11px] font-medium text-slate-600">Turf (Sq Ft)</label>
              <input type="number" id="client-turf" oninput="calculateEstimates()" value="0" class="w-full border p-1 rounded bg-white" />
            </div>
            <div>
              <label class="block text-[11px] font-medium text-slate-600">Garden Beds</label>
              <input type="number" id="client-beds" value="0" class="w-full border p-1 rounded bg-white" />
            </div>
            <div>
              <label class="block text-[11px] font-medium text-slate-600">Snow Drive (Lin Ft)</label>
              <input type="number" id="client-snow" value="0" class="w-full border p-1 rounded bg-white" />
            </div>
          </div>
          <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-2 rounded text-[11px] flex justify-between items-center">
            <span>Aeration Rate ($20/1k sq ft):</span>
            <span id="calc-aeration-price" class="font-bold text-xs">$0.00</span>
          </div>
        </div>

        <!-- Property / Gate Notes -->
        <div>
          <label class="block font-semibold mb-1">Valve Box / Gate Code / Access Notes</label>
          <textarea id="client-notes" rows="2" placeholder="Backflow location, gate code, pets on site..." class="w-full border p-2 rounded"></textarea>
        </div>

        <div class="flex justify-end gap-2 pt-2 border-t">
          <button type="button" onclick="closeClientModal()" class="px-3 py-1.5 border rounded hover:bg-slate-100">Cancel</button>
          <button type="submit" class="px-4 py-1.5 bg-emerald-700 hover:bg-emerald-600 text-white rounded font-bold">Save Client</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: ADD STOP TO TODAY'S ROUTE -->
  <div id="modal-stop" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-3">
    <div class="bg-white rounded-lg max-w-sm w-full p-4 space-y-3 shadow-xl text-xs">
      <div class="flex justify-between items-center border-b pb-2">
        <h3 class="font-bold text-slate-800 text-sm">Add Client to Route</h3>
        <button onclick="closeAddStopModal()" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>

      <div>
        <label class="block font-semibold mb-1">Select Client</label>
        <select id="stop-client-select" class="w-full border p-2 rounded bg-white text-xs"></select>
      </div>

      <div class="grid grid-cols-2 gap-2">
        <div>
          <label class="block font-semibold mb-1">Service Task</label>
          <input type="text" id="stop-task" value="Lawn Care / Maintenance" class="w-full border p-2 rounded text-xs" />
        </div>
        <div>
          <label class="block font-semibold mb-1">Duration (Min)</label>
          <input type="number" id="stop-duration" value="30" class="w-full border p-2 rounded text-xs" />
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-2 border-t">
        <button type="button" onclick="closeAddStopModal()" class="px-3 py-1.5 border rounded">Cancel</button>
        <button type="button" onclick="confirmAddStop()" class="px-3 py-1.5 bg-emerald-700 hover:bg-emerald-600 text-white rounded font-bold">Add Stop</button>
      </div>
    </div>
  </div>

  <!-- JavaScript -->
  <script>
    const DEPOT_ADDRESS = "3587 S 8150 W, Magna, UT";

    // Start with clean, empty state
    let clients = JSON.parse(localStorage.getItem('cals_clients')) || [];
    let route = JSON.parse(localStorage.getItem('cals_route')) || [];

    function saveState() {
      localStorage.setItem('cals_clients', JSON.stringify(clients));
      localStorage.setItem('cals_route', JSON.stringify(route));
    }

    // Tab Navigation
    function switchTab(tab) {
      document.getElementById('tab-route').classList.toggle('hidden', tab !== 'route');
      document.getElementById('tab-clients').classList.toggle('hidden', tab !== 'clients');
      document.getElementById('tab-btn-route').classList.toggle('tab-active', tab === 'route');
      document.getElementById('tab-btn-clients').classList.toggle('tab-active', tab === 'clients');
      lucide.createIcons();
    }

    // Route Logic & Rendering
    function renderRoute() {
      const container = document.getElementById('route-list');
      container.innerHTML = '';

      if (route.length === 0) {
        container.innerHTML = `<div class="bg-white p-6 rounded-lg text-center text-slate-400 text-xs">No stops on route today. Tap "+ Add Stop" to select a client.</div>`;
        return;
      }

      const startTimeVal = document.getElementById('route-start-time').value || "08:00";
      let [currentHour, currentMin] = startTimeVal.split(':').map(Number);

      route.forEach((stop, index) => {
        const client = clients.find(c => c.id === stop.clientId) || { name: "Unknown", address: "N/A", phone: "" };

        const arrivalTime = formatTime(currentHour, currentMin);
        currentMin += stop.durationMin;
        while (currentMin >= 60) {
          currentHour = (currentHour + 1) % 24;
          currentMin -= 60;
        }
        const departureTime = formatTime(currentHour, currentMin);

        let cardBg = "bg-white border-slate-200";
        if (stop.status === 'completed') cardBg = "bg-emerald-50 border-emerald-300 opacity-90";
        if (stop.status === 'skipped') cardBg = "bg-red-50 border-red-200 opacity-70";

        const card = document.createElement('div');
        card.className = `p-3 rounded-lg border shadow-sm transition ${cardBg} space-y-2.5`;
        card.innerHTML = `
          <div class="flex justify-between items-start">
            <div>
              <div class="flex items-center gap-1.5">
                <span class="bg-slate-800 text-white font-bold rounded-full w-5 h-5 flex items-center justify-center text-[10px]">${index + 1}</span>
                <h4 class="font-bold text-slate-800 text-sm">${client.name}</h4>
                <span class="text-[10px] bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded border border-slate-200">${stop.task}</span>
              </div>
              <p class="text-xs text-slate-500 mt-0.5">${client.address}</p>
            </div>
            <div class="text-right">
              <span class="text-xs font-mono font-semibold text-emerald-800">${arrivalTime} - ${departureTime}</span>
              <p class="text-[10px] text-slate-400">${stop.durationMin} mins</p>
            </div>
          </div>

          ${client.notes ? `<div class="bg-amber-50 border border-amber-200 text-amber-800 text-[11px] px-2 py-1 rounded"><strong>Note:</strong> ${client.notes}</div>` : ''}

          <!-- Action Bar -->
          <div class="flex items-center justify-between pt-1 border-t border-slate-100">
            <div class="flex items-center gap-1.5">
              <a href="https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(client.address)}" target="_blank" class="bg-sky-600 hover:bg-sky-500 text-white px-2 py-1 rounded text-xs flex items-center gap-1 font-medium shadow-sm">
                <i data-lucide="navigation" class="w-3.5 h-3.5"></i> Nav
              </a>
              <a href="sms:${client.phone}?body=${encodeURIComponent("Hi " + client.name + ", this is Cal's Landscaping. We are en route to your property with an ETA of approx 15-20 minutes.")}" class="bg-slate-700 hover:bg-slate-600 text-white px-2 py-1 rounded text-xs flex items-center gap-1 font-medium shadow-sm">
                <i data-lucide="message-square" class="w-3.5 h-3.5"></i> Text ETA
              </a>
            </div>

            <!-- Complete, Skip, Reorder Controls -->
            <div class="flex items-center gap-1">
              <button onclick="setStopStatus(${index}, 'completed')" class="p-1 rounded ${stop.status === 'completed' ? 'bg-emerald-600 text-white' : 'hover:bg-emerald-100 text-emerald-700'}" title="Mark Complete">
                <i data-lucide="check-circle-2" class="w-5 h-5"></i>
              </button>
              <button onclick="setStopStatus(${index}, 'skipped')" class="p-1 rounded ${stop.status === 'skipped' ? 'bg-red-600 text-white' : 'hover:bg-red-100 text-red-600'}" title="Mark Skipped">
                <i data-lucide="x-circle" class="w-5 h-5"></i>
              </button>
              <button onclick="moveStop(${index}, -1)" ${index === 0 ? 'disabled class="opacity-20"' : 'class="hover:bg-slate-200 text-slate-600"'} class="p-1 rounded" title="Move Up">
                <i data-lucide="arrow-up" class="w-4 h-4"></i>
              </button>
              <button onclick="moveStop(${index}, 1)" ${index === route.length - 1 ? 'disabled class="opacity-20"' : 'class="hover:bg-slate-200 text-slate-600"'} class="p-1 rounded" title="Move Down">
                <i data-lucide="arrow-down" class="w-4 h-4"></i>
              </button>
            </div>
          </div>
        `;
        container.appendChild(card);
      });

      lucide.createIcons();
    }

    function formatTime(hour, min) {
      const ampm = hour >= 12 ? 'PM' : 'AM';
      const formattedHour = hour % 12 || 12;
      const formattedMin = min < 10 ? '0' + min : min;
      return `${formattedHour}:${formattedMin} ${ampm}`;
    }

    function setStopStatus(index, status) {
      route[index].status = route[index].status === status ? 'pending' : status;
      saveState();
      renderRoute();
    }

    function resetStopsStatus() {
      route.forEach(s => s.status = 'pending');
      saveState();
      renderRoute();
    }

    function moveStop(index, direction) {
      const targetIndex = index + direction;
      if (targetIndex < 0 || targetIndex >= route.length) return;
      const temp = route[index];
      route[index] = route[targetIndex];
      route[targetIndex] = temp;
      saveState();
      renderRoute();
    }

    // Clients Logic & Rendering
    function renderClients() {
      const container = document.getElementById('clients-list');
      const query = (document.getElementById('client-search').value || '').toLowerCase();
      container.innerHTML = '';

      const filtered = clients.filter(c => 
        c.name.toLowerCase().includes(query) || 
        c.phone.includes(query) || 
        c.address.toLowerCase().includes(query)
      );

      if (filtered.length === 0) {
        container.innerHTML = `<div class="bg-white p-6 rounded-lg text-center text-slate-400 text-xs">No clients in database. Tap "Add Client" or "Sync Contacts".</div>`;
        return;
      }

      filtered.forEach(client => {
        const aerationPrice = ((client.turfSqFt || 0) / 1000 * 20).toFixed(2);
        const card = document.createElement('div');
        card.className = "bg-white p-3 rounded-lg border border-slate-200 shadow-sm space-y-2 text-xs";
        card.innerHTML = `
          <div class="flex justify-between items-start">
            <div>
              <div class="flex items-center gap-2">
                <h4 class="font-bold text-slate-800 text-sm">${client.name}</h4>
                <span class="text-[10px] font-semibold px-1.5 py-0.2 rounded ${client.type === 'Commercial' ? 'bg-indigo-50 text-indigo-700' : 'bg-slate-100 text-slate-600'}">${client.type}</span>
              </div>
              <p class="text-slate-500 mt-0.5">${client.address}</p>
            </div>
            <div class="flex gap-1.5">
              <a href="tel:${client.phone}" class="p-1.5 bg-slate-100 hover:bg-slate-200 rounded text-slate-700"><i data-lucide="phone" class="w-3.5 h-3.5"></i></a>
              <button onclick="editClient('${client.id}')" class="p-1.5 bg-slate-100 hover:bg-slate-200 rounded text-slate-700"><i data-lucide="edit-2" class="w-3.5 h-3.5"></i></button>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-2 bg-slate-50 p-2 rounded text-[11px] text-slate-600">
            <div><span class="font-semibold">Turf:</span> ${client.turfSqFt ? client.turfSqFt.toLocaleString() + ' sq ft' : '0 sq ft'}</div>
            <div><span class="font-semibold">Controller:</span> ${client.controller || 'None'}</div>
            <div><span class="font-semibold">Aeration:</span> $${aerationPrice}</div>
          </div>

          ${client.notes ? `<p class="text-[11px] text-slate-500"><strong class="text-slate-700">Access:</strong> ${client.notes}</p>` : ''}
        `;
        container.appendChild(card);
      });

      lucide.createIcons();
    }

    // Modal & Client Save Handlers
    function openClientModal() {
      document.getElementById('client-form').reset();
      document.getElementById('client-id').value = '';
      document.getElementById('modal-client-title').textContent = 'Add New Client';
      document.getElementById('calc-aeration-price').textContent = '$0.00';
      document.getElementById('modal-client').classList.remove('hidden');
    }

    function closeClientModal() {
      document.getElementById('modal-client').classList.add('hidden');
    }

    function calculateEstimates() {
      const turf = parseFloat(document.getElementById('client-turf').value) || 0;
      const aerationCost = (turf / 1000) * 20;
      document.getElementById('calc-aeration-price').textContent = `$${aerationCost.toFixed(2)}`;
    }

    function saveClient(e) {
      e.preventDefault();
      const id = document.getElementById('client-id').value || 'c-' + Date.now();
      const clientData = {
        id,
        name: document.getElementById('client-name').value,
        phone: document.getElementById('client-phone').value,
        address: document.getElementById('client-address').value,
        type: document.getElementById('client-type').value,
        controller: document.getElementById('client-controller').value,
        turfSqFt: parseFloat(document.getElementById('client-turf').value) || 0,
        bedsSqFt: parseFloat(document.getElementById('client-beds').value) || 0,
        snowLinFt: parseFloat(document.getElementById('client-snow').value) || 0,
        notes: document.getElementById('client-notes').value
      };

      const existingIndex = clients.findIndex(c => c.id === id);
      if (existingIndex > -1) {
        clients[existingIndex] = clientData;
      } else {
        clients.push(clientData);
      }

      saveState();
      closeClientModal();
      renderClients();
      renderRoute();
    }

    function editClient(id) {
      const client = clients.find(c => c.id === id);
      if (!client) return;

      document.getElementById('client-id').value = client.id;
      document.getElementById('client-name').value = client.name;
      document.getElementById('client-phone').value = client.phone;
      document.getElementById('client-address').value = client.address;
      document.getElementById('client-type').value = client.type;
      document.getElementById('client-controller').value = client.controller;
      document.getElementById('client-turf').value = client.turfSqFt || 0;
      document.getElementById('client-beds').value = client.bedsSqFt || 0;
      document.getElementById('client-snow').value = client.snowLinFt || 0;
      document.getElementById('client-notes').value = client.notes || '';

      calculateEstimates();
      document.getElementById('modal-client-title').textContent = 'Edit Client';
      document.getElementById('modal-client').classList.remove('hidden');
    }

    // Modal & Stop Handlers
    function openAddStopModal() {
      const select = document.getElementById('stop-client-select');
      if (clients.length === 0) {
        alert('Please add a client first before adding stops to the route.');
        return;
      }
      select.innerHTML = clients.map(c => `<option value="${c.id}">${c.name} (${c.address})</option>`).join('');
      document.getElementById('modal-stop').classList.remove('hidden');
    }

    function closeAddStopModal() {
      document.getElementById('modal-stop').classList.add('hidden');
    }

    function confirmAddStop() {
      const clientId = document.getElementById('stop-client-select').value;
      const task = document.getElementById('stop-task').value;
      const durationMin = parseInt(document.getElementById('stop-duration').value) || 30;

      route.push({
        id: 'r-' + Date.now(),
        clientId,
        task,
        durationMin,
        status: 'pending'
      });

      saveState();
      closeAddStopModal();
      renderRoute();
    }

    // Contact Picker API (Chrome / Android)
    async function importContactsNative() {
      if ('contacts' in navigator && 'ContactsManager' in window) {
        try {
          const props = ['name', 'tel', 'address'];
          const contacts = await navigator.contacts.select(props, { multiple: true });
          contacts.forEach(contact => {
            const name = contact.name && contact.name[0] ? contact.name[0] : 'Imported Contact';
            const phone = contact.tel && contact.tel[0] ? contact.tel[0] : '';
            const address = contact.address && contact.address[0] ? 
              `${contact.address[0].addressLine || ''}, ${contact.address[0].city || ''}` : '';

            clients.push({
              id: 'c-' + Date.now() + Math.random().toString(36).substring(2, 5),
              name,
              phone,
              address: address || 'Needs Address, UT',
              type: 'Residential',
              controller: 'Rain Bird',
              turfSqFt: 0,
              bedsSqFt: 0,
              snowLinFt: 0,
              notes: 'Imported from device contacts'
            });
          });
          saveState();
          renderClients();
          alert(`Successfully imported ${contacts.length} contact(s).`);
        } catch (err) {
          console.warn('Contact picker cancelled or failed:', err);
        }
      } else {
        alert('Native contact syncing is supported directly on Android Chrome.');
      }
    }

    // Initialize App
    window.addEventListener('DOMContentLoaded', () => {
      renderRoute();
      renderClients();
      lucide.createIcons();
    });
  </script>
</body>
</html>
